[Unit]
Description=Sailfish developer agent (screenshots and system logs for VS Code)
Documentation=https://github.com/minhdangphuoc/sardina
# The socket lives in the user's runtime directory and screenshots need the session bus.
After=user@100000.service
Wants=user@100000.service

[Service]
Type=simple
User=defaultuser
# lipstick's screenshot API checks the caller's effective group (the owner group of /proc/<pid>),
# so `privileged` must be the primary group; the journal only needs a supplementary one.
Group=privileged
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/sailfish-devagent --daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
