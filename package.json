        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.agent.uninstall",
        "title": "Uninstall Device Agent",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.agent.status",
        "title": "Device Agent Status",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
