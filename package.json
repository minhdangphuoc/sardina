    "walkthroughs": [
      {
        "id": "sardina.gettingStarted",
        "title": "Get started with SFOS",
        "description": "Set up the SFOS SDK, create a project, and build, deploy and run it.",
        "steps": [
          {
            "id": "installSdk",
            "title": "Install and detect the SFOS SDK",
            "description": "Install the SFOS SDK and point the extension at it.\n[Set SDK Path](command:sardina.setSdkPath)",
            "media": {
              "markdown": "media/walkthrough/installSdk.md"
            },
            "completionEvents": [
              "onContext:sardina.sdkAvailable"
            ]
          },
          {
            "id": "createProject",
            "title": "Create a project",
            "description": "Create a new SFOS application from a template.\n[New Project](command:sardina.newProject)",
            "media": {
              "markdown": "media/walkthrough/createProject.md"
            },
            "completionEvents": [
              "onCommand:sardina.newProject"
            ]
          },
          {
            "id": "selectTarget",
            "title": "Select a build target",
            "description": "Choose which SFOS build target to use.\n[Select Target](command:sardina.selectTarget)",
            "media": {
              "markdown": "media/walkthrough/selectTarget.md"
            },
            "completionEvents": [
              "onContext:sardina.hasTarget"
            ]
          },
          {
            "id": "startEmulator",
            "title": "Start the emulator",
            "description": "Start the SFOS emulator to deploy and test your app.\n[Start Emulator](command:sardina.emulator.start)",
            "media": {
              "markdown": "media/walkthrough/startEmulator.md"
            },
            "completionEvents": [
              "onCommand:sardina.emulator.start"
            ]
          },
          {
            "id": "buildDeployRun",
            "title": "Build, deploy and run",
            "description": "Build your app, deploy it, and run it in one step.\n[Build, Deploy and Run](command:sardina.buildDeployRun)",
            "media": {
              "markdown": "media/walkthrough/buildDeployRun.md"
            },
            "completionEvents": [
              "onCommand:sardina.buildDeployRun"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "sardina.buildDeployRun",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "sardina.isProject"
      }
    ]
