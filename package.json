{
  "name": "sardina",
  "displayName": "Sardina — SFOS Dev Kit",
  "description": "Unofficial community extension for building, deploying, and managing SFOS apps via sfdk and QML.",
  "keywords": [
    "sfos",
    "sfdk",
    "qml",
    "silica",
    "jolla",
    "sardina"
  ],
  "publisher": "sailfish-tools-dev",
  "version": "0.1.12",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/minhdangphuoc/vscode-sailfish.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Sardina runs the SDK's sfdk on workspace build files, so it needs a trusted workspace."
    }
  },
  "extensionDependencies": [
    "theqtcompany.qt-qml"
  ],
  "extensionPack": [],
  "activationEvents": [
    "workspaceContains:rpm/*.spec",
    "workspaceContains:**/*.pro",
    "workspaceContains:**/CMakeLists.txt",
    "onCommand:sardina.newProject",
    "onCommand:sardina.setSdkPath",
    "onCommand:sardina.downloadSdk",
    "onCommand:sardina.sdk.install",
    "onCommand:sardina.device.add",
    "onCommand:sardina.device.remove",
    "onCommand:sardina.setupSigning",
    "onView:sardina.build",
    "onView:sardina.sdk",
    "onView:sardina.devices",
    "onLanguage:qml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qml",
        "aliases": [
          "QML",
          "qml"
        ],
        "extensions": [
          ".qml"
        ]
      }
    ],
    "commands": [
      {
        "command": "sardina.setSdkPath",
        "title": "Set SDK Path",
        "category": "Sardina"
      },
      {
        "command": "sardina.downloadSdk",
        "title": "Download SDK",
        "category": "Sardina"
      },
      {
        "command": "sardina.sdk.install",
        "title": "Install SDK",
        "category": "Sardina",
        "icon": "$(cloud-download)",
        "enablement": "sardina.platformSupported"
      },
      {
        "command": "sardina.engine.start",
        "title": "Start Build Engine",
        "category": "Sardina",
        "icon": "$(debug-start)",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.engine.stop",
        "title": "Stop Build Engine",
        "category": "Sardina",
        "icon": "$(debug-stop)",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.newProject",
        "title": "New Project",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.selectTarget",
        "title": "Select Target",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.setSfdkDefaultTarget",
        "title": "Set sfdk Default Target",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.debugOnDevice",
        "title": "Debug on Device",
        "category": "Sardina",
        "icon": "$(debug-alt)",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.setupSigning",
        "title": "Set Up Package Signing",
        "category": "Sardina"
      },
      {
        "command": "sardina.selectBuildType",
        "title": "Select Build Type",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.selectDeployMethod",
        "title": "Select Deploy Method",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.build",
        "title": "Build",
        "icon": "$(tools)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.deploy",
        "title": "Deploy",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.run",
        "title": "Run",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.buildDeployRun",
        "title": "Build, Deploy and Run",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.runInstalled",
        "title": "Run Installed App",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.debugInstalled",
        "title": "Debug Installed App",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.package",
        "title": "Package",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.clean",
        "title": "Clean",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.cleanProjectBuild",
        "title": "Clean Project Build",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.rebuild",
        "title": "Rebuild",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.check",
        "title": "Validate RPM",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.stopBuild",
        "title": "Stop Build",
        "icon": "$(debug-stop)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.showBuildLog",
        "title": "Show Build Log",
        "icon": "$(output)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.devices.refresh",
        "title": "Refresh Devices",
        "icon": "$(refresh)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.emulator.start",
        "title": "Start Emulator",
        "icon": "$(debug-start)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.emulator.stop",
        "title": "Stop Emulator",
        "icon": "$(debug-stop)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.emulator.status",
        "title": "Emulator Status",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.emulator.show",
        "title": "Show Emulator",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.emulator.installAvailable",
        "title": "Install Available Emulator",
        "icon": "$(cloud-download)",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.device.setDefault",
        "title": "Set Default Device",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.device.stopSessions",
        "title": "Stop Sessions on Device",
        "category": "Sardina",
        "icon": "$(debug-stop)",
        "enablement": "sardina.platformSupported"
      },
      {
        "command": "sardina.device.setSfdkDefault",
        "title": "Set sfdk Default Device",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.device.openSsh",
        "title": "Open SSH to Device",
        "category": "Sardina",
        "enablement": "sardina.sdkAvailable && sardina.platformSupported"
      },
      {
        "command": "sardina.device.connectWlan",
        "title": "Connect to Device (WLAN)",
