  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "build:tests": "tsc -p tsconfig.test.json",
    "check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p src/monitor/webview/tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "test:unit": "npm run build:tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:fuzz": "npm run build:tests && mocha \"out/test/fuzz/**/*.test.js\"",
    "test:integration": "npm run build:tests && node out/test/runTest.js",
    "test": "npm run test:unit && npm run test:fuzz && npm run test:integration",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:proprietary": "node scripts/check-proprietary.mjs",
    "package:dry": "node scripts/package-dry.mjs",
    "verify": "npm run check:types && npm run lint && npm run test && npm run check:manifest && npm run check:proprietary && npm run build && npm run package:dry"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "^0.25.0",
    "@types/vscode": "~1.94.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.0",
    "mocha": "^10.0.0",
    "sinon": "^19.0.0",
    "@types/sinon": "^17.0.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "glob": "^11.0.0"
  }
}
