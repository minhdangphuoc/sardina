    "configuration": {
      "title": "Sardina",
      "properties": {
        "sardina.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the SFOS SDK installation root. Leave empty to auto-detect via environment and default locations."
        },
        "sardina.devicesXmlPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the SDK's `devices.xml` (libsfdk's device registry, shared with Qt Creator). Leave empty to auto-detect."
        },
        "sardina.target": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The sfdk build target to use for this workspace (e.g. `SailfishOS-4.4.0.58-aarch64`). Leave empty to use the sfdk default target."
        },
        "sardina.device": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The sfdk device (emulator or hardware) to deploy to and run on for this workspace."
        },
        "sardina.showSnapshotTargets": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Show snapshot targets in target-selection pickers, in addition to regular targets."
        },
        "sardina.build.jobs": {
          "type": "integer",
          "default": 0,
          "scope": "resource",
          "markdownDescription": "Number of parallel build jobs to pass to sfdk. `0` uses the sfdk default."
        },
        "sardina.build.runHarbourCheck": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Run the Harbour compliance check (`sfdk check`) automatically as part of the build task."
        },
        "sardina.debug.openDeviceMonitor": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Open the Device Monitor tab (connection, app stats and actions) beside the editor when you start **Debug on Device** or **Debug Installed App**. The editor keeps the focus."
        },
        "sardina.monitor.pollIntervalSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "scope": "window",
          "markdownDescription": "Seconds between app statistics samples when the device agent has no stats stream (device agent older than 1.10.0). Each sample is one `sfdk device exec` call."
        },
        "sardina.monitor.logLines": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "scope": "window",
          "markdownDescription": "How many of the newest device log lines **Show Device Logs** asks for when its stream starts."
        },
        "sardina.build.revealLog": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show the \"Sardina Build\" output channel when Run, Debug or Deploy starts building. The build log is streamed to the channel either way."
        },
        "sardina.build.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Extra arguments appended to every `sfdk build` invocation for this workspace."
        },
        "sardina.build.type": {
          "type": "string",
          "enum": [
            "release",
            "debug"
          ],
          "enumDescriptions": [
            "Release build (`sfdk build`).",
            "Debug build: `sfdk build --enable-debug`, compiled unoptimised (`-O0 -g`) so breakpoints and variables match the source."
          ],
          "default": "release",
          "scope": "resource",
          "markdownDescription": "Build type used by the build, deploy and run tasks. Also selectable from the status bar."
        },
        "sardina.build.sign": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Sign the RPM packages produced by the build, deploy, run and package tasks (`sfdk build --sign`, `sfdk package --sign`). Needs a GPG key; see `sardina.build.signingUser`."
        },
        "sardina.build.signingUser": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The GPG key to sign with, passed to sfdk as `package.signing-user`: a user name, or a key ID or fingerprint. A name matches every key that contains it (`Jane Doe` also matches `Jane Doe Dev`), so the setup command saves the fingerprint. Leave empty to use the value from `sfdk config`."
        },
        "sardina.build.signingPassphraseFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a file (mode 600) holding the key's passphrase, passed to sfdk as `package.signing-passphrase-file`. sfdk only reads the first line, and the file must be under the SFOS SDK workspace (your home directory by default). Leave empty to use the value from `sfdk config`. The passphrase itself is never stored in settings."
        },
        "sardina.build.cleanOnArchChange": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Clean the build output without asking when the target's architecture changes (e.g. `i486` → `aarch64`). In-source builds otherwise reuse objects compiled for the previous architecture and produce a broken package."
        },
        "sardina.deploy.method": {
          "type": "string",
          "enum": [
            "sdk",
            "pkcon",
            "rsync",
            "zypper",
            "zypper-dup",
            "manual"
          ],
          "enumDescriptions": [
            "Deploy as RPM package (the SDK's native method; needs Developer Mode).",
            "Install the RPM with pkcon.",
            "Deploy by copying binaries: transfers the RPM buildroot to /opt/sdk/<name> without installing an RPM.",
            "Install the RPM with zypper (needs zypper and root on the device).",
            "Install the RPM with zypper dup (needs zypper and root on the device).",
            "Copy the RPM to ~/RPMS on the device for manual installation; Run does not launch the app."
          ],
          "default": "sdk",
          "scope": "resource",
          "markdownDescription": "The deployment method used by the `deploy` task."
        },
        "sardina.run.launcher": {
          "type": "string",
          "enum": [
            "auto",
            "invoker-silica",
            "sailfish-qml",
            "custom"
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "How the application is launched on the device. `auto` picks the launcher based on the project shape."
        },
        "sardina.run.customCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Custom remote launch command used when `sardina.run.launcher` is `custom`."
        },
        "sardina.run.killBeforeLaunch": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Kill any previously running instance of the application on the device before launching it again."
        },
        "sardina.qtqml.silenceQmlls": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Disable the Qt QML extension's `qmlls` language server for this SFOS project folder. SFOS build targets ship Qt 5.6, and `qmlls` requires Qt 6.8+, so it only produces spurious diagnostics against Silica QML."
        },
        "sardina.qml.languageFeatures": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Completion, hover and diagnostics for QML, read from the selected build target."
        },
        "sardina.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "debug"
          ],
          "default": "info",
          "scope": "window",
          "markdownDescription": "Verbosity of the **Sardina** output channel."
        },
        "sardina.experimental.enableWindows": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "**Experimental.** Enable experimental Windows support (via MSYS2). Windows is otherwise unsupported in v0.1."
        },
        "sardina.experimental.msys2Shell": {
          "type": "string",
          "default": "C:\\msys64\\msys2_shell.cmd",
          "scope": "machine",
          "markdownDescription": "**Experimental.** Path to the MSYS2 shell launcher, used only when `sardina.experimental.enableWindows` is enabled."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "sardina",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "deploy",
              "run",
              "package",
              "check",
              "clean",
              "matrix-build",
              "logs"
            ]
          },
          "target": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "debug": {
            "type": "boolean"
          },
          "prepare": {
            "type": "boolean"
          },
          "noCheck": {
            "type": "boolean"
          },
          "jobs": {
            "type": "integer"
          },
          "extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deployMethod": {
            "type": "string",
            "enum": [
              "sdk",
              "pkcon",
              "rsync",
              "zypper",
              "zypper-dup",
              "manual"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "sardina-gcc",
        "owner": "sardina",
        "source": "gcc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(fatal error|error|warning|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "sardina-qmake",
        "owner": "sardina",
        "source": "qmake",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?\\.pr[io]):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "sardina-rpmbuild",
        "owner": "sardina",
        "source": "rpmbuild",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(rpm/\\S+\\.spec):\\s*error:\\s+(?:line\\s+(\\d+):\\s+)?(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "applyTo": "allDocuments"
      },
      {
        "name": "sardina-rpmvalidator",
        "owner": "sardina",
        "source": "rpmvalidator",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(rpm/\\S+\\.spec):\\s*(ERROR|WARNING|INFO)\\s*\\[?([^\\]]*)\\]?:?\\s*(.*)$",
          "file": 1,
          "severity": 2,
          "code": 3,
          "message": 4,
          "kind": "file"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sardina",
          "title": "Sardina",
          "icon": "resources/sardina.svg"
        }
      ]
    },
    "views": {
      "sardina": [
        {
          "id": "sardina.build",
